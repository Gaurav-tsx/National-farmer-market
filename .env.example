# =================================================================
# NAM-Core Environment Configuration Template
# Set these in your Vercel Project Settings -> Environment Variables
# =================================================================

# 1. APPLICATION & BACKEND API (Render / Koyeb)
NEXT_PUBLIC_APP_URL="https://your-vercel-app.vercel.app"
# If using external backend on Render or Koyeb, set URL here (e.g. https://nam-backend.onrender.com)
# If left empty, the frontend uses Next.js Route Handlers out of the box!
NEXT_PUBLIC_BACKEND_URL=""

# 2. PRIMARY DATABASE (PostgreSQL on Supabase or Neon.tech)
# Pooled connection string (Port 6543 for Supabase / Neon)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:6543/postgres?pgbouncer=true"
# Direct connection string for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# 3. EPHEMERAL & REDIS CACHE (Upstash Redis)
# For Mandi spot rates (15m TTL) & district feeds (180s TTL)
UPSTASH_REDIS_REST_URL="https://[YOUR-UPSTASH-INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-REST-TOKEN]"

# 4. AUTHENTICATION & GOOGLE SSO (Supabase Auth / Google OAuth)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
GOOGLE_CLIENT_ID="[YOUR-GOOGLE-CLIENT-ID].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="[YOUR-GOOGLE-CLIENT-SECRET]"

# 5. OBJECT STORAGE (Cloudflare R2 or Supabase Storage for KYC docs & crop media)
CLOUDFLARE_R2_ACCOUNT_ID="[YOUR-CLOUDFLARE-ACCOUNT-ID]"
CLOUDFLARE_R2_ACCESS_KEY_ID="[YOUR-R2-ACCESS-KEY]"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="[YOUR-R2-SECRET-KEY]"
CLOUDFLARE_R2_BUCKET_NAME="nam-core-assets"
NEXT_PUBLIC_R2_PUBLIC_URL="https://assets.yourorg.gov.in"

# 6. REGULATORY & CRYPTOGRAPHIC SECURITY
KYC_SECURITY_PEPPER="nam_core_pepper_salt_bharat_2026_x99_secret"
NEXTAUTH_SECRET="nam_super_secure_random_jwt_secret_token_128bit"
